# Node.js 24+. Copy to .env and run: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/studio.sqlite
# Set to 0 BEFORE first launch to create an empty studio with first-owner setup.
DEMO_MODE=1
# Enable only behind HTTPS; secure cookies cannot be used over plain HTTP.
COOKIE_SECURE=0
